{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/progress-nudge.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y interlink-mcp wait",
            "async": true,
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:interlink:interlink",
            "tool": "bind_claude_session",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "hook_event_name": "SessionStart"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:interlink:interlink",
            "tool": "end_claude_session",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:interlink:interlink",
            "tool": "bind_claude_session",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "hook_event_name": "UserPromptSubmit"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_interlink_interlink__",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:interlink:interlink",
            "tool": "bind_claude_session",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "hook_event_name": "PreToolUse"
            }
          }
        ]
      }
    ]
  }
}
